
body {
    background-color: #faf9f5;
}

header {
    border-bottom: 3px solid darkgreen;
}

nav {
    background-color: green;
}

.logo {
    width: 480px;
    max-width: 100%;
}

.buy {
    background-color: #2e7d32;
    border-radius: 10px;
}

.sell {
    background-color: #1d4f91;
    border-radius: 10px;
}

.buy:hover {
    background-color: #1f5e24;
}

.sell:hover {
    background-color: #153b6a;
}

footer {
    background-color: #1d4f91;
}

footer a {
    color: white;
}

footer a:hover {
    color: lightgreen;
}
